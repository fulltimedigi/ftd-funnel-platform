    "origins": [
      "indian",
      "cambodi",
      "any"
    ]
  },
  "price_tertiles": {
    "t1": 458.5,
    "t2": 945,
    "note": "budget band: <=t1 =0, >=t2 =2, else 1; budget_ceiling is a NEVER_RELAX ceiling per ق13"
  },
  "classification": {
    "exact_fulfillment": "returned product: format matches AND band<=ceiling AND (origin=any OR origin token present)",
    "hard_violation": "returned product violates a HARD choice: wrong format OR band>ceiling (over budget, NEVER_RELAX)",
    "silent_compromise": "returned product but fails a SOFT choice only (origin ignored) — THE BETRAYAL",
    "honest_no_match": "brain returns NO_MATCH AND ground-truth is empty (honest degradation)",
    "false_no_match": "(diagnostic) brain returns NO_MATCH while ground-truth is non-empty"
  },
