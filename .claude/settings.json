{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/quick-syntax-check.sh\"",
            "timeout": 15,
            "statusMessage": "Syntax-checking edited file…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/full-gate.sh\"",
            "timeout": 600,
            "statusMessage": "Running full verification gate (npm test)…"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-setup.sh\"",
            "timeout": 300,
            "statusMessage": "Checking toolchain…"
          }
        ]
      }
    ]
  }
}
